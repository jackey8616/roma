# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
.idea/
*.swp
*.swo

# Environment / secrets
.env
.env.local
.env.*.local
# A GitHub App private key, which ADR-0008 has roma read from a path rather than
# from a variable — so unlike every other secret here it arrives as a *file*, and
# a file in the repo root is one `git add -A` away from being permanent. Ignored
# by extension rather than by name because the name is the operator's choice.
*.pem

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies / build output
node_modules/
dist/
build/
coverage/

# Agent scratch space (prototypes, working notes)
.scratch/

# Agent worktrees. A git worktree checked out inside the repo it belongs to —
# committing one would embed a second copy of the tree in itself.
.claude/worktrees/

# Local test scratch (seam 2 working dirs, isolated claude config)
.tmp/

# Terraform. `.terraform.lock.hcl` is deliberately not here — it pins the
# provider and belongs in the repo. State is ignored because it is a local
# record of one deployment, not part of the template.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
